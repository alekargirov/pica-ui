{
  "name": "pica-ui",
  "version": "0.1.0",
  "description": "pica design system \u2014 components and themes for pica apps",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build:fonts": "node scripts/build-fonts.mjs"
  },
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./base": "./src/base.css",
    "./all": "./src/all.css",
    "./themes.bundle.css": "./src/themes.bundle.css",
    "./switcher.js": "./src/switcher.js",
    "./themes/*": "./src/themes/*.css"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@lucide/svelte": ">=0.400.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "vitest": "^2.1.0"
  }
}
